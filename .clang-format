---
# Borland C++Builder 5 reconstruction style. Mirrors the hand-written source:
# Allman braces, 4-space indent, right-aligned pointers, ~90 column limit.
# SortIncludes is OFF: include order is semantic here (vcl.h before
# #pragma hdrstop, the unit header after) and reordering would change the diff.
Language: Cpp
BasedOnStyle: LLVM
Standard: c++03
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 90
BreakBeforeBraces: Allman
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
PointerAlignment: Right
DerivePointerAlignment: false
AlignAfterOpenBracket: Align
BinPackArguments: false
BinPackParameters: false
ContinuationIndentWidth: 4
IndentPPDirectives: None
SortIncludes: false
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
Cpp11BracedListStyle: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
BreakConstructorInitializersBeforeComma: false
ConstructorInitializerAllOnOneLineOrOnePerLine: true
...
